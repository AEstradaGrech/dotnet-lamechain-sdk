<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
	  <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.8" />
    <PackageReference Include="OllamaSharp" Version="5.4.25" />
  </ItemGroup>
	<PropertyGroup>
		<AssemblyName>Estrada.OllamaSharp.LameChain.SDK</AssemblyName>
		<PackageId>Estrada.OllamaSharp.LameChain.SDK</PackageId>
		<Version>0.1.2-alpha</Version>
		<AssemblyVersion>0.1.2.0</AssemblyVersion>
		<InformationalVersion>0.1.2-alpha</InformationalVersion>
		<Title>Dotnet OllamaSharp LameChain SDK</Title>
		<Authors>Alvaro Estrada</Authors>
		<Description>.Net SDK to create complex chains of LLM instructions in a Fluent way and execute them with ollama using the OllamaSharp integration (https://github.com/awaescher/OllamaSharp)</Description>
		<PackageTags>ai llm agentic-framework rag-tool fluent-api ollama ollamasharp</PackageTags>
		<PackageProjectUrl>https://github.com/AEstradaGrech/dotnet-lamechain-sdk</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/AEstradaGrech/dotnet-lamechain-sdk</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>
	<PropertyGroup>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
	</ItemGroup>
</Project>
